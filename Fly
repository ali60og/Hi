-- الأنيميشن (من السكربت السابق)
local ANIM_IDLE  = {10714347256, 4}
local ANIM_FWD   = {10714177846, 4.65}
local ANIM_BACK  = {10147823318, 4.11}
local ANIM_LEFT  = {10147823318, 3.55}
local ANIM_RIGHT = {10147823318, 4.81}

local trackCache = {}
local currentKey, currentTrack

local function getParts()
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return char, hum, root
end

local function PlayAnim(a)
	local key = a[1] .. "_" .. a[2]
	if currentKey == key then return end
	local _, hum = getParts()
	if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator") or hum
	local track = trackCache[key]
	if not track then
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. a[1]
		track = animator:LoadAnimation(anim)
		trackCache[key] = track
	end
	if currentTrack and currentTrack ~= track then currentTrack:Stop(0.1) end
	track:Play(0.1)
	track.TimePosition = a[2]
	track:AdjustSpeed(0)
	currentKey, currentTrack = key, track
end

local function ClearAnim()
	if currentTrack then currentTrack:Stop(0.1) end
	currentKey, currentTrack = nil, nil
end

local BLOCK_STATES = {
	Enum.HumanoidStateType.Freefall,
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
}

local function setBlocked(hum, blocked)
	for _, s in ipairs(BLOCK_STATES) do
		hum:SetStateEnabled(s, not blocked)
	end
end

local function stopFly()
	flying = false
	upHeld, downHeld = false, false
	if flyConn then flyConn:Disconnect(); flyConn = nil end
	ClearAnim()
	local char, hum, root = getParts()
	if root and flyPos and flyFlat then
		-- اعتدال كامل قبل فك التثبيت
		root.CFrame = CFrame.lookAt(flyPos, flyPos + flyFlat)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = false
	end
	if hum then
		hum.AutoRotate = true
		setBlocked(hum, false)
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	pcall(function() char.Animate.Disabled = false end)
	onof.Text = "fly: OFF"
end

local function startFly()
	local char, hum, root = getParts()
	if not (char and hum and root) then return end

	flying = true
	onof.Text = "fly: ON"
	setBlocked(hum, true)
	hum.AutoRotate = false

	pcall(function() char.Animate.Disabled = true end)
	for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop() end
	PlayAnim(ANIM_IDLE)

	flyPos = root.Position
	local look0 = workspace.CurrentCamera.CFrame.LookVector
	flyFlat = Vector3.new(look0.X, 0, look0.Z).Unit
	local rotCF = root.CFrame.Rotation
	local k = 0 -- مقدار الميلان (0 واقف .. 1 مستلقي 90 درجة)

	root.AssemblyLinearVelocity = Vector3.zero
	root.Anchored = true -- تثبيت = لا اهتزاز ولا انزلاق ولا سقوط

	flyConn = RunService.RenderStepped:Connect(function(dt)
		local c, h, r = getParts()
		if not (c and h and r) then return end
		if h.Health <= 0 then stopFly() return end

		local cam = workspace.CurrentCamera
		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then flyFlat = flat.Unit end

		local step = speeds * STUDS_PER_LEVEL * dt
		local md = h.MoveDirection
		local move = Vector3.zero
		local vy = 0
		local anim = ANIM_IDLE
		local targetK = 0

		if md.Magnitude > 0.1 then
			move = md * step
			local f = md:Dot(flyFlat)
			local rr = md:Dot(cam.CFrame.RightVector)
			vy = look.Y * f * step
			if math.abs(f) >= math.abs(rr) then
				if f > 0 then
					anim = ANIM_FWD
					targetK = 1
				else
					anim = ANIM_BACK
				end
			else
				anim = rr > 0 and ANIM_RIGHT or ANIM_LEFT
			end
		end

		if upHeld then vy += step end
		if downHeld then vy -= step end

		PlayAnim(anim)
		flyPos = flyPos + move + Vector3.new(0, vy, 0)

		-- الميلان: 90 درجة للأمام، ويتبع نظر الكاميرا للأعلى/الأسفل
		local a = 1 - math.exp(-12 * dt)
		k = k + (targetK - k) * a
		local pitch = math.clamp(math.asin(math.clamp(look.Y, -1, 1)), -math.rad(60), math.rad(60))
		local theta = k * (pitch - math.rad(90))
		local targetRot = CFrame.lookAt(Vector3.zero, flyFlat) * CFrame.Angles(theta, 0, 0)
		rotCF = rotCF:Lerp(targetRot, a)

		r.CFrame = CFrame.new(flyPos) * rotCF
	end)
end

onof.MouseButton1Click:Connect(function()
	if flying then stopFly() else startFly() end
end)

local function hold(button, setter)
	button.MouseButton1Down:Connect(function() setter(true) end)
	button.MouseButton1Up:Connect(function() setter(false) end)
	button.MouseLeave:Connect(function() setter(false) end)
end
hold(up, function(v) upHeld = v end)
hold(down, function(v) downHeld = v end)

local function setSpeed(n)
	speeds = math.clamp(n, 1, MAX_SPEEDS)
	speedLabel.Text = tostring(speeds)
end
plus.MouseButton1Click:Connect(function() setSpeed(speeds + 1) end)
mine.MouseButton1Click:Connect(function() setSpeed(speeds - 1) end)

