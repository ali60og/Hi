local borderGradients, fillGradients = {}, {}
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 70, 70)),
	ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 220, 60)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(80, 255, 110)),
	ColorSequenceKeypoint.new(0.50, Color3.fromRGB(70, 230, 255)),
	ColorSequenceKeypoint.new(0.67, Color3.fromRGB(100, 110, 255)),
	ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 90, 255)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 70, 70)),
})

local function rainbow(obj)
	obj.BackgroundColor3 = Color3.new(1, 1, 1)
	obj.BorderSizePixel = 0

	local fill = Instance.new("UIGradient")
	fill.Color = RAINBOW
	fill.Parent = obj
	table.insert(fillGradients, fill)

	local s = Instance.new("UIStroke")
	s.Color = Color3.new(1, 1, 1)
	s.Thickness = 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = obj
	local g = Instance.new("UIGradient")
	g.Color = RAINBOW
	g.Parent = s
	table.insert(borderGradients, g)
end

